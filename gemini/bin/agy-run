#!/bin/sh
set -eu
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
  TARGET=$(readlink "$SCRIPT")
  case "$TARGET" in
    /*) SCRIPT="$TARGET" ;;
    *) SCRIPT="$DIR/$TARGET" ;;
  esac
done
DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
exec "$HOME/.bun/bin/bun" "$DIR/agy-run.js" "$@"
