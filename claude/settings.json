{
  "syncClaudeAiSkills": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.atuin/bin/atuin\" hook claude-code"
          },
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/guard-git-push.js\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/guard-runtimes.js\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/guard-main-checkout.js\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/guard-pr-merge.js\"",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/hooks/board-hook.sh\" pre-tool-use claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__board__ask_user$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/guard-asks.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(EnterWorktree|Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/freshen-base.js\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.atuin/bin/atuin\" hook claude-code"
          },
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/auto-merge.js\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "^EnterWorktree$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/worktree-rule.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/hooks/board-hook.sh\" post-tool-use claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.atuin/bin/atuin\" hook claude-code"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/hooks/board-hook.sh\" post-tool-use-failure claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/hooks/board-hook.sh\" session-start claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/stale-base.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/worktree-rule.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/worktree-rule.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/hooks/board-hook.sh\" user-prompt-submit claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/hooks/board-hook.sh\" pre-compact claude",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/hooks/board-hook.sh\" stop claude",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.bun/bin/bun\" \"$HOME/.claude/hooks/open-items.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/hooks/board-hook.sh\" stop-failure claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.claude/hooks/board-hook.sh\" session-end claude",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "dotfiles": {
      "source": {
        "source": "github",
        "repo": "syz51/dotfiles",
        "sparsePaths": [".claude-plugin", "claude/marketplace"]
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "computer-use@dotfiles": true,
    "lean-prompt@dotfiles": true
  },
  "skillOverrides": {
    "artifact-capabilities": "name-only",
    "artifact-diagramming": "name-only",
    "workflow-authoring": "name-only",
    "init": "name-only",
    "loop": "name-only",
    "run": "name-only",
    "schedule": "name-only",
    "security-review": "name-only",
    "simplify": "name-only",
    "update-config": "name-only",
    "fewer-permission-prompts": "user-invocable-only",
    "keybindings-help": "user-invocable-only"
  },
  "sandbox": {
    "enabled": false
  },
  "worktree": {
    "baseRef": "head"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 200000,
  "skipDangerousModePermissionPrompt": true,
  "disableSkillShellExecution": true,
  "theme": "dark",
  "switchModelsOnFlag": false
}
