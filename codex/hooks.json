{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.atuin/bin/atuin\" hook codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.atuin/bin/atuin\" hook codex"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.cargo/bin/board\"; [ -x \"$b\" ] || exit 0; exec \"$b\" hook post-tool-use --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.cargo/bin/board\"; [ -x \"$b\" ] || exit 0; exec \"$b\" hook session-start --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.cargo/bin/board\"; [ -x \"$b\" ] || exit 0; exec \"$b\" hook user-prompt-submit --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.cargo/bin/board\"; [ -x \"$b\" ] || exit 0; exec \"$b\" hook stop --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.cargo/bin/board\"; [ -x \"$b\" ] || exit 0; exec \"$b\" hook session-end --runtime codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
