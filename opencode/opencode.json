{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/gpt-6.1-sol",
  "providers": {
    "opencode": {
      "models": {
        "gpt-6.1-sol": { "settings": { "reasoningEffort": "xhigh" } },
        "gpt-6-luna": { "settings": { "reasoningEffort": "max" } }
      }
    }
  },
  "instructions": ["{env:HOME}/.claude/CLAUDE.md"],
  "mcp": {
    "servers": {
      "board": {
        "type": "local",
        "command": ["/usr/bin/env", "-u", "T3CODE_THREAD_ID", "-u", "CLAUDE_CODE_SESSION_ID", "-u", "OPENCODE_SESSION_ID", "{env:HOME}/.cargo/bin/board", "mcp"],
        "codemode": false
      },
      "desktop": {
        "type": "local",
        "command": ["{env:HOME}/.bun/bin/bun", "{env:HOME}/.config/claude/marketplace/computer-use/server/desktop.js"],
        "codemode": false
      }
    }
  }
}
