{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/claude-opus-5-5#high",
  "instructions": ["{env:HOME}/.claude/CLAUDE.md"],
  "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }],
  "mcp": {
    "servers": {
      "board": {
        "type": "local",
        "command": ["/usr/bin/env", "-u", "T3CODE_THREAD_ID", "-u", "CLAUDE_CODE_SESSION_ID", "{env:HOME}/.cargo/bin/board", "mcp"],
        "codemode": false
      },
      "desktop": {
        "type": "local",
        "command": ["{env:HOME}/.bun/bin/bun", "{env:HOME}/.config/claude/marketplace/computer-use/server/desktop.js"],
        "codemode": false
      }
    }
  }
}
