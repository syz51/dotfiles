+/// Shared command/stdin ingestion. `read_until` is cancellation safe: bytes
+/// accumulated by a losing select branch stay in `buf`, including partial UTF-8
+/// or a partial record. A timer never turns those bytes into a candidate.
+async fn ingest_candidates<R: AsyncBufRead + Unpin, P: EntryProcessor>(
+    mut reader: R,
+    delimiter: u8,
+    processor: P,
+    injector: Injector<P::Data>,
+) -> bool {
+    let mut buf = Vec::with_capacity(DEFAULT_LINE_BUFFER_SIZE);
+    let mut batch = Vec::with_capacity(BATCH_SIZE);
+    let mut initial = true;
+    let mut deadline = None;
+    let mut produced_output = false;
+    let mut last_flush = Instant::now();
