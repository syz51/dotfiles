+        stalled_stdin_prefix(1).await;
+    }
+    #[tokio::test]
+    async fn initial_stdin_64_stalled_prefix() {
+        stalled_stdin_prefix(64).await;
+    }
+
+    async fn stalled_command_prefix(count: usize) {
+        // Gate the actual shell producer on a private FIFO, with no sleeps or EOF.
+        let dir = tempfile::tempdir().unwrap();
+        let gate = dir.path().join("gate");
+        assert!(
+            std::process::Command::new("mkfifo")
+                .arg(&gate)
+                .status()
+                .unwrap()
+                .success()
+        );
+        let command = format!(
+            r#"i=0; while [ $i -lt {count} ]; do printf 'row%s\n' "$i"; i=$((i+1)); done; read answer < '{}'; printf 'later\nfinal'"#,
+            gate.display()
+        );
+        let command = CommandSpec::from(Template::parse(&command).unwrap());
+        let matcher = Matcher::<()>::new(SortStrategy::Index, 1);
+        let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+        let task = tokio::spawn(load_candidates(
+            command,
+            None,
+            0,
+            RecordingProcessor(tx),
+            matcher.injector(),
+        ));
+        receive_prefix(&mut rx, count).await;
+        assert!(!task.is_finished());
+        let writer = tokio::task::spawn_blocking(move || {
+            std::fs::write(gate, b"continue\n").unwrap()
+        });
+        writer.await.unwrap();
+        task.await.unwrap();
+        assert_eq!(rx.recv().await.unwrap(), "later");
+        assert_eq!(rx.recv().await.unwrap(), "final");
+        assert!(rx.recv().await.is_none());
+    }
