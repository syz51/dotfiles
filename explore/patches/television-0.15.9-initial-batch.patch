+            unreachable!()
+        }
+    }
+
+    async fn receive_prefix(
+        rx: &mut tokio::sync::mpsc::UnboundedReceiver<String>,
+        count: usize,
+    ) {
+        // 100ms leaves scheduler headroom but fails the stock 200ms/EOF batching.
+        tokio::time::timeout(Duration::from_millis(100), async {
+            for i in 0..count {
+                assert_eq!(rx.recv().await.unwrap(), format!("row{i}"));
+            }
+        })
+        .await
+        .expect("useful prefix must arrive before producer EOF");
+    }
+
+    async fn stalled_stdin_prefix(count: usize) {
+        use tokio::io::AsyncWriteExt;
+        let (mut writer, reader) = tokio::io::duplex(8192);
+        let matcher = Matcher::<()>::new(SortStrategy::Index, 1);
+        let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+        // This is the same generic ingestion entry point used by real stdin.
+        let task = tokio::spawn(ingest_candidates(
+            BufReader::new(reader),
+            b'\n',
+            RecordingProcessor(tx),
+            matcher.injector(),
+        ));
+        for i in 0..count {
+            writer
+                .write_all(format!("row{i}\n").as_bytes())
+                .await
+                .unwrap();
+        }
+        // Leave a partial multibyte record pending across the initial timer.
+        writer.write_all(b"later-\xc3").await.unwrap();
+        receive_prefix(&mut rx, count).await;
+        assert!(!task.is_finished(), "producer has not closed");
+        assert!(
+            rx.try_recv().is_err(),
+            "partial records must not be injected"
+        );
+        writer.write_all(b"\xa9\nfinal").await.unwrap();
+        drop(writer);
+        assert!(task.await.unwrap());
+        assert_eq!(rx.recv().await.unwrap(), "later-é");
+        assert_eq!(rx.recv().await.unwrap(), "final");
+        assert!(rx.recv().await.is_none());
+    }
+
