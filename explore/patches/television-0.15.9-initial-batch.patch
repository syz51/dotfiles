+    #[derive(Clone)]
+    struct RecordingProcessor(tokio::sync::mpsc::UnboundedSender<String>);
+
+    impl EntryProcessor for RecordingProcessor {
+        type Data = ();
+        fn push_to_injector(&self, line: String, _: &Injector<()>) {
+            self.0.send(line).unwrap();
+        }
