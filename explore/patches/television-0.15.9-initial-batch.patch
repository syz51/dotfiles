+// Mirror flush_batch's filtering, including removal of a custom delimiter
+// before decoding UTF-8. The initial deadline must start for actual candidates.
+fn useful_record(bytes: &[u8], delimiter: u8) -> bool {
+    if bytes.is_empty() || bytes.iter().all(u8::is_ascii_whitespace) {
+        return false;
+    }
+    let line = bytes.strip_suffix(&[delimiter]).unwrap_or(bytes);
+    std::str::from_utf8(line).is_ok()
 }
 
