+        let read_result = if let Some(at) = deadline {
+            tokio::select! {
+                // Prioritize the deadline even when input is continuously ready.
+                biased;
+                () = tokio::time::sleep_until(at) => {
+                    flush_batch(std::mem::take(&mut batch), &injector, &processor, delimiter);
+                    initial = false;
+                    deadline = None;
+                    last_flush = Instant::now();
+                    continue;
+                }
+                result = reader.read_until(delimiter, &mut buf) => result,
             }
-
