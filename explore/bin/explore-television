#!/bin/zsh -f
# Keep the patched binary private to Explore; ordinary tv stays on PATH.
emulate -LR zsh
if [[ -n ${EXPLORE_TELEVISION:-} ]]; then
  [[ $EXPLORE_TELEVISION == /* && -f $EXPLORE_TELEVISION && -x $EXPLORE_TELEVISION ]] || {
    print -u2 'explore: EXPLORE_TELEVISION must be an absolute path to an executable file'
    exit 69
  }
  exec "$EXPLORE_TELEVISION" "$@"
fi
private=$HOME/.local/opt/explore-television/tv
if [[ -f $private && -x $private ]]; then
  exec "$private" "$@"
fi
exec tv "$@"
